# Port HTTP du backend. Valeur utilisée si elle est absente ou invalide : 4000.
PORT=4000

# Dossier de stockage absolu facultatif. Laisser vide pour utiliser le dossier temporaire système.
SONORA_DOWNLOAD_DIR=

# Nombre d’heures de conservation des fichiers terminés avant suppression.
SONORA_FILE_RETENTION_HOURS=24

# URL du frontend pour les requêtes CORS. Laisser vide pour désactiver CORS.
FRONTEND_URL=